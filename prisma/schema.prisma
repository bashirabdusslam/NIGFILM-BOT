generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  telegramId String     @unique
  firstName  String?
  lastName   String?
  username   String?
  createdAt  DateTime   @default(now())
  carts      Cart[]
  orders     Order[]
  purchases  Purchase[]
}

model Film {
  id           Int        @id @default(autoincrement())
  title        String
  description  String
  category     String
  price        Int
  posterFileId String?
  videoFileId  String
  createdAt    DateTime   @default(now())
  carts        Cart[]
  orders       Order[]
  purchases    Purchase[]
}
model Order {
  id                      Int        @id @default(autoincrement())
  telegramId              String
  filmId                  Int
  cartFilmIds             String?
  amount                  Int
  status                  String
  paymentReference        String     @unique
  createdAt               DateTime   @default(now())
  accountName             String?
  accountNumber           String?
  bankName                String?
  virtualAccountReference String?
  film                    Film       @relation(fields: [filmId], references: [id])
  user                    User       @relation(fields: [telegramId], references: [telegramId])
  purchases               Purchase[]

  @@index([telegramId])
}

model Purchase {
  id         Int      @id @default(autoincrement())
  telegramId String
  filmId     Int
  orderId    Int
  createdAt  DateTime @default(now())
  film       Film     @relation(fields: [filmId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
  user       User     @relation(fields: [telegramId], references: [telegramId])

  @@index([telegramId])
}

model AdminSession {
  id         Int    @id @default(autoincrement())
  telegramId String @unique
  step       String
  filmData   String
}

model Cart {
  id         Int      @id @default(autoincrement())
  telegramId String
  filmId     Int
  createdAt  DateTime @default(now())
  film       Film     @relation(fields: [filmId], references: [id])
  user       User     @relation(fields: [telegramId], references: [telegramId])

  @@unique([telegramId, filmId])
  @@index([telegramId])
}

model UserSession {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  step       String
  data       String
  createdAt  DateTime @default(now())
}