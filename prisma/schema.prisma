generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  firstName  String?
  lastName   String?
  username   String?
  createdAt  DateTime @default(now())

  carts     Cart[]
  orders    Order[]
  purchases Purchase[]
}

enum WebUserRole {
  USER
  ADMIN
}

enum AppLanguage {
  HAUSA
  ENGLISH
}

enum AppTheme {
  BLACK_GOLD
  WHITE_GOLD
}

enum PremiumPlan {
  WEEKLY
  MONTHLY
  YEARLY
}

enum PremiumStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model WebUser {
  id           Int         @id @default(autoincrement())
  fullName     String
  phone        String      @unique
  passwordHash String
  role         WebUserRole @default(USER)

  language AppLanguage @default(HAUSA)
  theme    AppTheme    @default(BLACK_GOLD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webPurchases         WebPurchase[]
  webOrders            WebOrder[]
  webSessions          WebSession[]
  premiumSubscriptions PremiumSubscription[]
  premiumOrders        PremiumOrder[]
}

model WebSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  webUserId Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user WebUser @relation(fields: [webUserId], references: [id], onDelete: Cascade)

  @@index([webUserId])
  @@index([expiresAt])
}

model PremiumSubscription {
  id               Int           @id @default(autoincrement())
  webUserId        Int
  plan             PremiumPlan
  status           PremiumStatus @default(ACTIVE)
  amount           Int
  paymentReference String?       @unique
  startsAt         DateTime      @default(now())
  expiresAt        DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user WebUser @relation(fields: [webUserId], references: [id], onDelete: Cascade)

  @@index([webUserId])
  @@index([status])
  @@index([expiresAt])
  @@index([webUserId, status])
}

model PremiumOrder {
  id               Int         @id @default(autoincrement())
  webUserId        Int
  plan             PremiumPlan
  amount           Int
  status           String      @default("pending")
  paymentReference String      @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user WebUser @relation(fields: [webUserId], references: [id], onDelete: Cascade)

  @@index([webUserId])
  @@index([status])
}

model Film {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  category    String
  price       Int

  posterFileId String?
  posterUrl    String?

  videoFileId String?

  bunnyVideoId String?
  webVideoUrl  String?

  trailerBunnyVideoId String?
  trailerUrl          String?
  trailerEnabled      Boolean @default(false)

  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  carts        Cart[]
  orders       Order[]
  purchases    Purchase[]
  webOrders    WebOrder[]
  webPurchases WebPurchase[]

  @@index([category])
  @@index([createdAt])
  @@index([featured])
}

model Order {
  id               Int      @id @default(autoincrement())
  telegramId       String
  filmId           Int
  cartFilmIds      String?
  amount           Int
  status           String
  paymentReference String   @unique
  createdAt        DateTime @default(now())

  accountName             String?
  accountNumber           String?
  bankName                String?
  virtualAccountReference String?

  film Film @relation(fields: [filmId], references: [id])
  user User @relation(fields: [telegramId], references: [telegramId])

  purchases Purchase[]

  @@index([telegramId])
  @@index([filmId])
  @@index([status])
}

model WebOrder {
  id               Int      @id @default(autoincrement())
  webUserId        Int
  filmId           Int
  amount           Int
  status           String   @default("pending")
  paymentReference String   @unique
  createdAt        DateTime @default(now())

  user WebUser @relation(fields: [webUserId], references: [id])
  film Film    @relation(fields: [filmId], references: [id])

  webPurchases WebPurchase[]

  @@index([webUserId])
  @@index([filmId])
  @@index([status])
}

model Purchase {
  id         Int      @id @default(autoincrement())
  telegramId String
  filmId     Int
  orderId    Int
  createdAt  DateTime @default(now())

  film  Film  @relation(fields: [filmId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [telegramId], references: [telegramId])

  @@index([telegramId])
  @@index([filmId])
  @@index([orderId])
}

model WebPurchase {
  id        Int      @id @default(autoincrement())
  webUserId Int
  filmId    Int
  orderId   Int
  createdAt DateTime @default(now())

  user  WebUser  @relation(fields: [webUserId], references: [id])
  film  Film     @relation(fields: [filmId], references: [id])
  order WebOrder @relation(fields: [orderId], references: [id])

  @@unique([webUserId, filmId])
  @@index([webUserId])
  @@index([filmId])
  @@index([orderId])
}

model AdminSession {
  id         Int    @id @default(autoincrement())
  telegramId String @unique
  step       String
  filmData   String
}

model Cart {
  id         Int      @id @default(autoincrement())
  telegramId String
  filmId     Int
  createdAt  DateTime @default(now())

  film Film @relation(fields: [filmId], references: [id])
  user User @relation(fields: [telegramId], references: [telegramId])

  @@unique([telegramId, filmId])
  @@index([telegramId])
  @@index([filmId])
}

model UserSession {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  step       String
  data       String
  createdAt  DateTime @default(now())
}
