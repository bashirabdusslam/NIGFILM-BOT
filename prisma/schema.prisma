generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  firstName  String?
  lastName   String?
  username   String?
  createdAt  DateTime @default(now())

  carts     Cart[]
  orders    Order[]
  purchases Purchase[]
}

enum WebUserRole {
  USER
  ADMIN
}

enum AppLanguage {
  HAUSA
  ENGLISH
}

enum AppTheme {
  BLACK_GOLD
  WHITE_GOLD
}

model WebUser {
  id           Int         @id @default(autoincrement())
  fullName     String
  phone        String      @unique
  passwordHash String
  role         WebUserRole @default(USER)

  language AppLanguage @default(HAUSA)
  theme    AppTheme    @default(BLACK_GOLD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webPurchases WebPurchase[]
  webOrders    WebOrder[]
  webSessions  WebSession[]
}

model WebSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  webUserId Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user WebUser @relation(fields: [webUserId], references: [id], onDelete: Cascade)

  @@index([webUserId])
  @@index([expiresAt])
}

model Film {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  category    String
  price       Int

  // Telegram poster
  posterFileId String?

  // Permanent web/app poster
  posterUrl String?

  // Old Telegram video
  videoFileId String?

  // Bunny full movie
  bunnyVideoId String?
  webVideoUrl  String?

  // Trailer
  trailerBunnyVideoId String?
  trailerUrl          String?
  trailerEnabled      Boolean @default(false)

  // Home/featured display
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  carts     Cart[]
  orders    Order[]
  purchases Purchase[]

  webOrders    WebOrder[]
  webPurchases WebPurchase[]

  @@index([category])
  @@index([createdAt])
  @@index([featured])
}

model Order {
  id               Int      @id @default(autoincrement())
  telegramId       String
  filmId           Int
  cartFilmIds      String?
  amount           Int
  status           String
  paymentReference String   @unique
  createdAt        DateTime @default(now())

  accountName             String?
  accountNumber           String?
  bankName                String?
  virtualAccountReference String?

  film Film @relation(fields: [filmId], references: [id])
  user User @relation(fields: [telegramId], references: [telegramId])

  purchases Purchase[]

  @@index([telegramId])
  @@index([filmId])
  @@index([status])
}

model WebOrder {
  id               Int      @id @default(autoincrement())
  webUserId        Int
  filmId           Int
  amount           Int
  status           String   @default("pending")
  paymentReference String   @unique
  createdAt        DateTime @default(now())

  user WebUser @relation(fields: [webUserId], references: [id])
  film Film    @relation(fields: [filmId], references: [id])

  webPurchases WebPurchase[]

  @@index([webUserId])
  @@index([filmId])
  @@index([status])
}

model Purchase {
  id         Int      @id @default(autoincrement())
  telegramId String
  filmId     Int
  orderId    Int
  createdAt  DateTime @default(now())

  film  Film  @relation(fields: [filmId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [telegramId], references: [telegramId])

  @@index([telegramId])
  @@index([filmId])
  @@index([orderId])
}

model WebPurchase {
  id        Int      @id @default(autoincrement())
  webUserId Int
  filmId    Int
  orderId   Int
  createdAt DateTime @default(now())

  user  WebUser  @relation(fields: [webUserId], references: [id])
  film  Film     @relation(fields: [filmId], references: [id])
  order WebOrder @relation(fields: [orderId], references: [id])

  @@unique([webUserId, filmId])
  @@index([webUserId])
  @@index([filmId])
  @@index([orderId])
}

model AdminSession {
  id         Int    @id @default(autoincrement())
  telegramId String @unique
  step       String
  filmData   String
}

model Cart {
  id         Int      @id @default(autoincrement())
  telegramId String
  filmId     Int
  createdAt  DateTime @default(now())

  film Film @relation(fields: [filmId], references: [id])
  user User @relation(fields: [telegramId], references: [telegramId])

  @@unique([telegramId, filmId])
  @@index([telegramId])
  @@index([filmId])
}

model UserSession {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  step       String
  data       String
  createdAt  DateTime @default(now())
}
